DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_NAME=mango_dev

# Generate your own, e.g. `openssl rand -base64 32` — never commit real values.
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

PORT=3000
CORS_ORIGIN=*

# Local-development escape hatch for the modules that have not covered auth yet
# (G06-G11). When true, protected routes accept requests with no token and run
# them as a seeded dev account, so those apps can reach admin CRUD and /orders
# without sending an Authorization header.
#
# A real bearer token still takes precedence and roles are still enforced for
# it, so the apps that DO implement auth (G12+) behave identically either way.
# The server refuses to boot with this enabled and NODE_ENV=production.
AUTH_BYPASS=false

# Role the implicit identity runs as: ADMIN (default, every route reachable) or
# USER (useful for checking that role-gated UI hides correctly).
AUTH_BYPASS_ROLE=ADMIN
